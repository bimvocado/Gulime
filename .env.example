# 금융감독원 금융상품 오픈API 키 (https://finlife.fss.or.kr 에서 발급)
FSS_API_KEY=your_fss_api_key_here

# Neon PostgreSQL 접속 정보 (https://neon.tech 에서 프로젝트 생성 후 발급)
DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_db_password_here

# 업스테이지 Solar API 키 - 우대조건 파싱용 (https://console.upstage.ai 에서 발급)
UPSTAGE_API_KEY=your_upstage_api_key_here